scripts=["
    create service user preview-sync-service with path system/cq:services/preview-sync

    set principal ACL for preview-sync-service
        allow jcr:read on /content/wknd
        allow jcr:read on /content/dam/wknd
        allow jcr:read on /content/experience-fragments/wknd
        allow jcr:read on /conf/wknd
        allow crx:replicate on /content/wknd
        allow crx:replicate on /content/dam/wknd
        allow crx:replicate on /content/experience-fragments/wknd
    end
"]
