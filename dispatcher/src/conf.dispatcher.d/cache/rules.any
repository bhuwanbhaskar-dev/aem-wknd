#
# This file contains the cache rules, and can be customized.
#
# By default, it includes the default rules.
#

$include "./default_rules.any"

# Never cache an authenticated, permission-sensitive analysis response.
# Keep custom labels unique; /0010 is already used by the default dispatcher rules.
/0013 {
    /glob "/bin/api/analyze-package*"
    /type "deny"
}
